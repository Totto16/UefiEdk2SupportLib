[Defines]
  INF_VERSION = 1.25
  BASE_NAME = SupportLibDefaultImpl
  FILE_GUID = fcbe5800-d8ad-45fd-9697-59e199b5e0dd
  MODULE_TYPE = DXE_DRIVER
  VERSION_STRING = 1.0.0
  LIBRARY_CLASS = LibUEfiSupport|UEFI_APPLICATION

  CONSTRUCTOR                    = OOpetrisSupportLibConstructorDefault

[Sources]
  clock.c
  nanosleep.c
  global.c

[Packages]
  MdePkg/MdePkg.dec
  StdLib/StdLib.dec
  PcAtChipsetPkg/PcAtChipsetPkg.dec

[LibraryClasses]
# MdePkg
  UefiLib
# StdLib
  LibC
  LibCtype
  LibLocale
  LibMath
  LibSignal
  LibStdio
  LibStdLib
  LibString
  LibTime
  LibUefi
  LibWchar
  LibGdtoa
#
  BaseLib
  PcdLib
  PciLib
  IoLib
  DebugLib
  HobLib

[BuildOptions]
  *_*_*_CC_FLAGS  = -std=c11

  *_*_*_CC_FLAGS = -D__UEFI__
  *_*_*_CC_FLAGS = "-DEFIAPI=__attribute__((ms_abi))"

  *_*_*_CC_FLAGS = -fvisibility=hidden
  *_*_*_CC_FLAGS = -D_REENTRANT
  *_*_*_CCONLY_FLAGS = -I$(MODULE_DIR)/
  *_*_*_CCONLY_FLAGS = -I$(MODULE_DIR)/../../include/

  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include

[BuildOptions.X64]
  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include/X64


[Protocols]
  gEfiTimerArchProtocolGuid



[Pcd]
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPciBusNumber             ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPciDeviceNumber          ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPciFunctionNumber        ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPciEnableRegisterOffset  ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoBarEnableMask            ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPciBarRegisterOffset     ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPortBaseAddress          ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiPm1TmrOffset               ## CONSUMES
  gPcAtChipsetPkgTokenSpaceGuid.PcdAcpiIoPortBaseAddressMask      ## CONSUMES
